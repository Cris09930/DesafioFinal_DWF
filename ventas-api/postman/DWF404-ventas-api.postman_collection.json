    {
      "name": "4. Token alterado o inválido -> 401",
      "item": [
        {
          "name": "Payload alterado (rol cambiado a ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cambia el rol dentro del payload SIN volver a firmar -> la firma ya no coincide",
                  "const [h, p, s] = pm.collectionVariables.get('tokenUsuario').split('.');",
                  "const json = JSON.parse(atob(p.replace(/-/g, '+').replace(/_/g, '/')));",
                  "json.roles = ['ADMIN'];",
                  "const nuevo = btoa(JSON.stringify(json)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('tokenAlterado', [h, nuevo, s].join('.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlterado}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Hamaca artesanal XL\",\n  \"descripcion\": \"Nahuizalco\",\n  \"precio\": 39.99,\n  \"stock\": 10\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Token basura",
