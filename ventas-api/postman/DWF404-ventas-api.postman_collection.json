                "key": "Authorization",
                "value": "Bearer {{tokenExpirado}}"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "auth": {
              "type": "noauth"
            },
            "description": "Arranque la API con JWT_EXPIRATION=1m, haga login, copie el accessToken a la variable tokenExpirado y espere ~2 minutos (60 s de tolerancia de reloj). También sirve un token de Keycloak de más de 5 min de antigüedad."
          }
        }
